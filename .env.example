# ==============================================================================
# JobSync Environment Configuration
# ==============================================================================

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
PORT=3000

# Authentication & Session Security
# Generate with: openssl rand -base64 32
JWT_SECRET="jobsync_super_secret_jwt_key_must_be_32_chars_minimum"
SESSION_COOKIE_NAME="jobsync_session"

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jobsync?schema=public"

# AI Provider - Google Gemini
# Supports: gemini-3.1-flash-lite, gemini-3.5-flash-lite, gemini-3.8-flash, gemini-2.5-flash-lite
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_DEEP_POLISH_MODEL="gemini-3.8-flash"

# India Payment Gateway - Razorpay
# Test keys format: rzp_test_...
RAZORPAY_KEY_ID="rzp_test_YourTestKeyId12345"
RAZORPAY_KEY_SECRET="YourRazorpaySecretKeyHere"
RAZORPAY_WEBHOOK_SECRET="YourRazorpayWebhookSecretHere"
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_YourTestKeyId12345"

# India Monetization & Unit Economics Parameters
USD_TO_INR_RATE=92.68
GST_PERCENTAGE=18.0
PAYMENT_GATEWAY_FEE_PERCENT=2.00
PAYMENT_GATEWAY_GST_PERCENT=18.0

# Rate Limiting & Abuse Prevention
RATE_LIMIT_MAX_PER_MINUTE=20
MAX_UPLOAD_SIZE_BYTES=5242880 # 5 MB
